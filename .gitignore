.DS_Store
.venv/
__pycache__/
*.py[cod]
.coverage
.pytest_cache/
.promotion-preview-*/
.promotion-prepare-*/
.entity-promotion-transaction/

# The full-backup GEDCOM (export/armond-family-history.ged) is committed: it is
# text that references the in-repo evidence/ scans. But GEDZIP bundles duplicate
# those scan bytes, and the 5.5.1 legacy file is a redundant on-demand variant —
# keep both out of git; regenerate with `make export-bundle` / `make export-legacy`.
export/*.gdz
export/*-5.5.1.ged

# Raw FamilySearch retrieval drop — the whole ephemeral working area (raw record
# images and ranked CSV/JSON, the external reference cache, plans, correspondence
# and the agent's synthesis). Promote valuable finds into data/ + evidence/ (or
# logs/) via the value gate; nothing inside is repository history.
research/from-retrieval/
# Local value-gate resume ledger for the retrieval drop, kept outside
# research/from-retrieval/ so a re-sync cannot clobber it (working file, not history)
from-retrieval-triage-ledger.md

# GitHub Pages build output (generated by scripts/build_pages_site.py)
_site/

# AI-assistant knowledge base — generated from data/ by scripts/build_knowledge_base.py
# (regenerated fresh into _site/kb on every Pages deploy; run `make knowledge-base`
# locally to serve the family-assistant Worker in development). Derived, not history.
family-tree-viewer/kb/

# Wrangler local-dev variables for the Workers (Gemini key, local KB base) — secret
.dev.vars
# Wrangler local state / build cache
.wrangler/

# Local planning and scratch files (never committed)
_local/
