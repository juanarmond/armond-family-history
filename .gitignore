.DS_Store
.venv/
__pycache__/
*.py[cod]
.coverage
.pytest_cache/
.promotion-preview-*/
.promotion-prepare-*/
.entity-promotion-transaction/

# Every GEDCOM export is a local, private backup and never tracked: the full
# backup carries living people and privately held records in full (owner
# decision, 2026-10-11). Regenerate with `make export` / `make export-bundle` /
# `make export-legacy`.
export/*.ged
export/*.gdz

# Private store (owner decision, 2026-10-11): living-person documents, the scans
# restricted to private storage, and the full originals of their records. This
# repository is public, so nothing under private/ may ever be tracked; validation
# checks these files only where the store is present.
private/

# The retrieval handoff (Channel A): text only, overwritten on every sync by the
# producer. Read it through `make intake`, never commit it.
research/from-retrieval/
# The narrative value-gate ledger now lives in the private repository
# (private/triage/); the public index is data/triage-index.yaml. Keep any stray
# local copy out of git.
from-retrieval-triage-ledger.md
# Intake state: pinned, verified handoff snapshots and the producer-scan hash cache
# (scripts/intake.py, scripts/producer_scans.py).
research/.intake/

# GitHub Pages build output (generated by scripts/build_pages_site.py)
_site/

# AI-assistant knowledge base — generated from data/ by scripts/build_knowledge_base.py
# (regenerated fresh into _site/kb on every Pages deploy; run `make knowledge-base`
# locally to serve the family-assistant Worker in development). Derived, not history.
family-tree-viewer/kb/

# Wrangler local-dev variables for the Workers (Gemini key, local KB base) — secret
.dev.vars
# Wrangler local state / build cache
.wrangler/

# Local planning and scratch files (never committed)
_local/

# Entity transaction lock (scripts/new_entity.py) and its momentary temp file
.entity-transaction.lock
.entity-transaction.lock.*.tmp
