{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armond-family-history.invalid/schemas/family.schema.json",
  "title": "Family",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "partners",
    "children",
    "event_ids",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/familyId"
    },
    "partners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_id",
          "role"
        ],
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/personId"
          },
          "role": {
            "type": "string",
            "enum": [
              "spouse",
              "partner",
              "parent"
            ]
          }
        }
      }
    },
    "partner_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_ids"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/confidenceStatus"
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds",
          "minItems": 1
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_id",
          "parent_relationships",
          "notes"
        ],
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/personId"
          },
          "parent_relationships": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parent_id",
                "relationship_type",
                "status",
                "source_ids",
                "notes"
              ],
              "properties": {
                "parent_id": {
                  "$ref": "common.schema.json#/$defs/personId"
                },
                "relationship_type": {
                  "type": "string",
                  "enum": [
                    "biological",
                    "adoptive",
                    "step",
                    "foster",
                    "guardian",
                    "social",
                    "unknown",
                    "other"
                  ]
                },
                "relationship_detail": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "$ref": "common.schema.json#/$defs/confidenceStatus"
                },
                "source_ids": {
                  "$ref": "common.schema.json#/$defs/sourceIds",
                  "minItems": 1
                },
                "notes": {
                  "$ref": "common.schema.json#/$defs/notes"
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "relationship_type"
                    ],
                    "properties": {
                      "relationship_type": {
                        "const": "other"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "relationship_detail"
                    ]
                  }
                }
              ]
            }
          },
          "notes": {
            "$ref": "common.schema.json#/$defs/notes"
          }
        }
      }
    },
    "event_ids": {
      "$ref": "common.schema.json#/$defs/eventIds"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "partners": {
            "contains": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "spouse",
                    "partner"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "partner_relationship"
        ]
      }
    },
    {
      "if": {
        "required": [
          "partner_relationship"
        ]
      },
      "then": {
        "properties": {
          "partners": {
            "minItems": 2,
            "items": {
              "properties": {
                "role": {
                  "enum": [
                    "spouse",
                    "partner"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
