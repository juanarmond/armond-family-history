{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armond-family-history.invalid/schemas/family.schema.json",
  "title": "Family",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "partners",
    "children",
    "event_ids",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/familyId"
    },
    "partners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_id",
          "role"
        ],
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/personId"
          },
          "role": {
            "type": "string",
            "enum": [
              "spouse",
              "partner"
            ]
          }
        }
      }
    },
    "partner_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_ids"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/confidenceStatus"
        },
        "source_ids": {
          "$ref": "common.schema.json#/$defs/sourceIds",
          "minItems": 1
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_id",
          "parent_ids",
          "status",
          "source_ids"
        ],
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/personId"
          },
          "parent_ids": {
            "$ref": "common.schema.json#/$defs/personIds",
            "minItems": 1,
            "maxItems": 2
          },
          "status": {
            "$ref": "common.schema.json#/$defs/confidenceStatus"
          },
          "source_ids": {
            "$ref": "common.schema.json#/$defs/sourceIds",
            "minItems": 1
          },
          "notes": {
            "$ref": "common.schema.json#/$defs/notes"
          }
        }
      }
    },
    "event_ids": {
      "$ref": "common.schema.json#/$defs/eventIds"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "partners": {
            "minItems": 2
          }
        }
      },
      "then": {
        "required": [
          "partner_relationship"
        ]
      }
    }
  ]
}
