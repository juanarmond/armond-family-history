{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armond-family-history.invalid/schemas/person.schema.json",
  "title": "Person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "preferred_name",
    "privacy",
    "name_variants",
    "event_ids",
    "family_ids",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/personId"
    },
    "preferred_name": {
      "type": "string",
      "minLength": 1
    },
    "privacy": {
      "type": "string",
      "enum": [
        "living",
        "deceased",
        "unknown"
      ]
    },
    "nationality": {
      "type": "string",
      "minLength": 1
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ]
    },
    "name_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "type",
          "source_ids"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "source",
              "birth",
              "married",
              "alias",
              "other"
            ]
          },
          "source_ids": {
            "$ref": "common.schema.json#/$defs/sourceIds",
            "minItems": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "occupations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "source_ids"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "$ref": "common.schema.json#/$defs/sourceIds",
            "minItems": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fan_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fan_id",
          "role"
        ],
        "properties": {
          "fan_id": {
            "$ref": "common.schema.json#/$defs/fanId"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "event_ids": {
      "$ref": "common.schema.json#/$defs/eventIds"
    },
    "family_ids": {
      "$ref": "common.schema.json#/$defs/familyIds"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "profile_pt": {
      "type": "string",
      "minLength": 1
    }
  }
}
