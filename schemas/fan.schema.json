{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armond-family-history.invalid/schemas/fan.schema.json",
  "title": "FAN reference",
  "description": "A record in which one of the family's people appears only in a functional or associative role (Friend/Associate/Neighbour): witness, appraiser (louvado), creditor, attorney, party, signatory, and so on. Retained as timeline, place, standing and network context. It is never evidence for a genealogical conclusion; usage is always 'context'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "record_type",
    "record_category",
    "usage",
    "repository",
    "access_date",
    "language",
    "transcription",
    "abstract",
    "digital_file",
    "participants",
    "private"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/fanId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "minLength": 1
    },
    "record_category": {
      "type": "string",
      "enum": [
        "court_or_probate",
        "notarial",
        "land_or_survey",
        "other"
      ]
    },
    "usage": {
      "const": "context"
    },
    "event_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "event_place_text": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "archive_or_registry": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_reference": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "access_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "transcription": {
      "type": "string",
      "minLength": 1
    },
    "transcription_pt": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "abstract_pt": {
      "type": "string",
      "minLength": 1
    },
    "digital_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^evidence/(?!.*\\.\\.).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_id",
          "role"
        ],
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/personId"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "linked_places": {
      "$ref": "common.schema.json#/$defs/placeIds"
    },
    "private": {
      "type": "boolean"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  }
}
