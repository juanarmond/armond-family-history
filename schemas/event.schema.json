{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armond-family-history.invalid/schemas/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "event_type",
    "date",
    "participants",
    "status",
    "source_ids",
    "notes"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/eventId"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "birth",
        "baptism",
        "marriage",
        "death",
        "burial",
        "residence",
        "immigration",
        "naturalisation",
        "occupation",
        "probate",
        "other"
      ]
    },
    "date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "place_id": {
      "$ref": "common.schema.json#/$defs/placeId"
    },
    "place_text": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_id",
          "role"
        ],
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/personId"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/confidenceStatus"
    },
    "source_ids": {
      "$ref": "common.schema.json#/$defs/sourceIds",
      "minItems": 1
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "anyOf": [
    {
      "required": [
        "place_id"
      ]
    },
    {
      "required": [
        "place_text"
      ]
    }
  ]
}
