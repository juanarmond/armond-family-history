{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armond-family-history.invalid/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "record_type",
    "record_category",
    "source_form",
    "information_quality",
    "evidence_type",
    "usage",
    "repository",
    "access_date",
    "language",
    "abstract",
    "reliability",
    "linked_people",
    "linked_families",
    "linked_events",
    "linked_places",
    "private"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/sourceId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_pt": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "minLength": 1
    },
    "record_category": {
      "type": "string",
      "enum": [
        "civil_registration",
        "parish_register",
        "census",
        "government_record",
        "court_or_probate",
        "immigration",
        "naturalisation",
        "military",
        "cemetery",
        "newspaper",
        "institutional_record",
        "official_index",
        "published_genealogy",
        "collaborative_tree",
        "family_recollection",
        "other"
      ]
    },
    "source_form": {
      "type": "string",
      "enum": [
        "original",
        "derivative",
        "authored_narrative"
      ]
    },
    "information_quality": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "mixed",
        "undetermined"
      ]
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "direct",
        "indirect",
        "negative",
        "undetermined"
      ]
    },
    "usage": {
      "type": "string",
      "enum": [
        "evidence",
        "lead_only",
        "context_only"
      ]
    },
    "event_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "event_place_text": {
      "type": "string",
      "minLength": 1
    },
    "registration_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "archive_or_registry": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "book": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "record_number": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_reference": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repository_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        }
      }
    },
    "access_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "transcription": {
      "type": "string"
    },
    "transcription_pt": {
      "type": "string"
    },
    "reading_reliability": {
      "description": "How completely the record's CORE genealogical facts could be read. 'complete' = every core fact (the subject, the event, its date and place, and any modelled kin named) is legible; inline [uncertain]/[illegible] marks, if any, fall only on peripheral text (a witness/godparent/declarant/attesting-physician/appraiser name, an ID/registration/folio number, a street or bairro, a stamp or marginal annotation, or a mere spelling/digit variant of something already identified). 'partial' = at least one core fact could not be read with certainty. The viewer shows the 'uncertain reading' badge only when this is 'partial'. Omit it when the transcription carries no gap markers at all.",
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "abstract_pt": {
      "type": "string",
      "minLength": 1
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment"
      ],
      "properties": {
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "informant": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "digital_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^evidence/(?!.*\\.\\.).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "redacted_derivative": {
          "type": "string",
          "minLength": 1,
          "pattern": "^evidence/(?!.*\\.\\.).+$"
        }
      }
    },
    "additional_pages": {
      "type": "array",
      "description": "Continuation pages of a multi-page document, in reading order, beyond the primary page held in `digital_file`; the viewer shows them after it. Every evidence file whose name starts with this source's id must be referenced by `digital_file` or `additional_pages`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^evidence/(?!.*\\.\\.).+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "linked_people": {
      "$ref": "common.schema.json#/$defs/personIds"
    },
    "linked_families": {
      "$ref": "common.schema.json#/$defs/familyIds"
    },
    "linked_events": {
      "$ref": "common.schema.json#/$defs/eventIds"
    },
    "linked_places": {
      "$ref": "common.schema.json#/$defs/placeIds"
    },
    "private": {
      "type": "boolean"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "anyOf": [
    {
      "required": [
        "linked_people"
      ],
      "properties": {
        "linked_people": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "linked_families"
      ],
      "properties": {
        "linked_families": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "linked_events"
      ],
      "properties": {
        "linked_events": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "linked_places"
      ],
      "properties": {
        "linked_places": {
          "minItems": 1
        }
      }
    }
  ]
}
